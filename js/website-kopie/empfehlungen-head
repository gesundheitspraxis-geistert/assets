<script type="text/javascript">
//<![CDATA[
(function(){
  function isImageUrl(url){
    return /\.(png|jpe?g|webp)(\?.*)?$/i.test(url || "");
  }

  function ensureBox(){
    let box = document.getElementById('gpLightbox');
    if(box) return box;

    box = document.createElement('div');
    box.id = 'gpLightbox';
    box.className = 'gp-lightbox';
    box.innerHTML = ''
      + '<div class="gp-lightbox__inner" role="dialog" aria-modal="true">'
      + '  <button class="gp-lightbox__close" type="button" aria-label="Schließen">×<\/button>'
      + '  <img class="gp-lightbox__img" alt="">'
      + '<\/div>';
    document.body.appendChild(box);

    function closeBox(){
      box.classList.remove('is-open');
      document.documentElement.style.overflow = '';
      const img = box.querySelector('.gp-lightbox__img');
      if(img) img.src = '';
    }

    box.addEventListener('click', (e)=>{ if(e.target === box) closeBox(); });
    box.querySelector('.gp-lightbox__close').addEventListener('click', closeBox);
    document.addEventListener('keydown', (e)=>{ if(e.key === 'Escape') closeBox(); });

    return box;
  }

  document.addEventListener('click', function(e){
    const a = e.target.closest('a.gp-imglink');
    if(!a) return;

    const href = a.getAttribute('href') || '';
    if(!isImageUrl(href)) return;

    e.preventDefault();
    const box = ensureBox();
    const img = box.querySelector('.gp-lightbox__img');

    img.src = href;
    img.alt = a.querySelector('img')?.alt || '';

    box.classList.add('is-open');
    document.documentElement.style.overflow = 'hidden';
  }, true);
})();
//]]>
</script>

<script type="text/javascript">
//<![CDATA[
(function(){
  const DURATION = 300;

  function getContent(details){
    return details.querySelector('.gp-details-content');
  }

  function openDetails(details){
    const c = getContent(details);
    if(!c){ details.open = true; return; }

    details.open = true;

    c.style.overflow = 'hidden';
    c.style.height = '0px';
    c.offsetHeight;

    const end = c.scrollHeight;
    c.style.transition = `height ${DURATION}ms ease`;
    c.style.height = end + 'px';

    c.addEventListener('transitionend', function te(){
      c.removeEventListener('transitionend', te);
      c.style.transition = '';
      c.style.height = 'auto';
    });
  }

  function closeDetails(details){
    const c = getContent(details);
    if(!c){ details.open = false; return; }

    const start = c.getBoundingClientRect().height;
    c.style.overflow = 'hidden';
    c.style.height = start + 'px';
    c.offsetHeight;

    c.style.transition = `height ${DURATION}ms ease`;
    c.style.height = '0px';

    c.addEventListener('transitionend', function te(){
      c.removeEventListener('transitionend', te);
      c.style.transition = '';
      details.open = false;
    });
  }

  document.addEventListener('click', function(e){
    const summary = e.target.closest('details.gp-details > summary');
    if(!summary) return;

    const details = summary.parentElement;
    e.preventDefault();

    if(details.open) closeDetails(details);
    else openDetails(details);
  }, true);

  document.addEventListener('DOMContentLoaded', function(){
    document.querySelectorAll('details.gp-details').forEach(d=>{
      const c = getContent(d);
      if(!c) return;
      c.style.height = d.open ? 'auto' : '0px';
      c.style.overflow = 'hidden';
    });
  });
})();
//]]>
</script>

<script type="text/javascript">
//<![CDATA[
(function(){
  const OFFSET = 80;
  const DELAY  = 60;

  function scrollToId(hash){
    if(!hash || hash === '#') return;
    const id = hash.replace('#','');
    const el = document.getElementById(id);
    if(!el) return;

    const y = el.getBoundingClientRect().top + window.pageYOffset - OFFSET;
    setTimeout(()=> window.scrollTo({ top: y, behavior: 'smooth' }), DELAY);
    history.replaceState(null, '', '#' + id);
  }

  document.addEventListener('change', function(e){
    const sel = e.target.closest('#gpJump');
    if(!sel) return;
    scrollToId(sel.value);
  }, true);
})();
//]]>
</script>

