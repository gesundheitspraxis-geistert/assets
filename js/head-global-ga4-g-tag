/* =========================================
   1) TOKENS (Marke & Kontrast)
   ========================================= */
:root{
  /* Marke */
  --gp-lila: #824e71;

  /* Basis-Grün (Footer-Ton) */
  --gp-gruen: #486C5E;
  --gp-gruen-rgb: 72, 108, 94;

  /* Linkfarben (aus Basis-Grün) */
  --gp-link: var(--gp-gruen);
  --gp-link-hover: #3E5F54;

  /* Marken-Hellgrün */
  --gp-hellgruen: #82A98F;
  --gp-hellgruen-rgb: 130, 169, 143;

  /* Button-Grün (nah am Basis-Grün) */
  --gp-btn-green: #5A7F73;
  --gp-btn-green-hover: #4C6E64;

  /* Icons/Bullets */
  --gp-icon: #3F5F55;

  /* Divider */
  --gp-divider-w: 80px;
  --gp-divider-h: 2px;
  --gp-divider-r: 2px;
  --gp-divider-my: 20px;
  --gp-divider-color: #c8d9d1;

  /* Button-System Stellschrauben */
  --gp-btn-radius: 14px;
  --gp-btn-pad-y: 14px;
  --gp-btn-pad-x: 24px;
  --gp-btn-font: 1.6rem;
  --gp-btn-weight: 600;

  --gp-btn-gap: 16px;
  --gp-btn-my: 16px;
  --gp-scroll-offset: 130px;
}


