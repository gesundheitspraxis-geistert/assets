.gp-box a.gp-btn-soft:hover,
.gp-box a.gp-btn-outline:hover,
.gp-box a.gp-btn-green-sm:hover{
  background: rgba(255,255,255,0.22) !important;
  border-color: rgba(255,255,255,0.48) !important;
}

/* Jimdo-Systembuttons in Boxen (falls noch ohne gp-btn Klasse) */
.gp-box a[data-action="button"]{
  color:#ffffff !important;
}
/* =========================================
   Steps / Ablauf-Box (Videosprechstunde)
   ========================================= */
.gp-steps__title{
  font-size: 1.8rem;
  font-weight: 600;
  margin: 0 0 18px 0;
  color:#fff;
}

.gp-steps__table{
  border-collapse: collapse;
  width: 100%;
}

.gp-steps__num{
  vertical-align: top;
  padding-right: 22px;
  color:#fff;
  font-size: 3.2rem;
  font-weight: 600;
  line-height: 1;
  width: 1%;
  white-space: nowrap;
}

.gp-steps__text{
  color:#fff;
  font-size: 1.45rem;
  line-height: 1.7;
  padding-bottom: 26px;
}

.gp-steps__text a{
  white-space: nowrap;
}

/* WhatsApp-Icon im Button */
.gp-wa-icon{
  height: 1.1em;
  vertical-align: middle;
  margin: 0 6px 0 4px;
}


/* Optional: kleine „Meta“-Zeile innerhalb Box */
.gp-box .gp-box-meta{
  opacity: 0.92;
}

/* Buttons IN farbigen Boxen – immer weiss, egal welcher Typ */
.gp-box--lila a.gp-btn,
.gp-box--lila a.gp-btn--green,
.gp-box--lila a.gp-btn-soft,
.gp-box--lila a.gp-btn-outline,
.gp-box--gruen a.gp-btn,
.gp-box--gruen a.gp-btn--green,
.gp-box--gruen a.gp-btn-soft,
.gp-box--gruen a.gp-btn-outline{
  color: #ffffff !important;
  text-decoration: none !important;
}


/* =========================================
   7) DARK SURFACES – SAUBERES SYSTEM
   Wichtig: Dieser Block kommt NACH den Buttonregeln,
   damit nichts "unsichtbar" wird.
   ========================================= */

/* 7a) Footer = Dark Surface */
.jtpl-section-aside,
.jtpl-section-aside footer{
  color: rgba(255,255,255,0.92);
}

/* Links im Footer IMMER weiß (inkl. span, visited) */
.jtpl-section-aside a,
.jtpl-section-aside a:visited,
.jtpl-section-aside a:hover,
.jtpl-section-aside a:focus,
.jtpl-section-aside a span,
.jtpl-section-aside a:visited span,
.jtpl-section-aside a:hover span{
  color:#ffffff !important;
  text-decoration:none !important;
  background:none !important;
}

/* Buttons im Footer: invertiert hell */
.jtpl-section-aside a.gp-btn,
.jtpl-section-aside a.gp-btn--green,
.jtpl-section-aside a.gp-btn-outline,
.jtpl-section-aside a.gp-btn-soft,
.jtpl-section-aside a.gp-btn-green-sm{
  color:#ffffff !important;
  background: rgba(255,255,255,0.16) !important;
  border: 1px solid rgba(255,255,255,0.45) !important;
  box-shadow: none !important;
}
.jtpl-section-aside a.gp-btn:hover,
.jtpl-section-aside a.gp-btn--green:hover,
.jtpl-section-aside a.gp-btn-outline:hover,
.jtpl-section-aside a.gp-btn-soft:hover,
.jtpl-section-aside a.gp-btn-green-sm:hover{
  background: rgba(255,255,255,0.24) !important;
  border-color: rgba(255,255,255,0.55) !important;
}



/* =========================================
   8) Listen (Häkchen) + TOC
   ========================================= */
.j-module ul,
.j-module ol{
  margin: 0.6em 0 1em 0;
  padding-left: 0 !important;
  list-style: none !important;
}
.j-module ul li,
.j-module ol li{
  position: relative;
  padding-left: 1.35em;
  margin: 0.35em 0;
}
.j-module ul li::before{
  content: "✓";
  position: absolute;
  left: 0;
  top: 0.05em;
  color: var(--gp-icon);
  font-weight: 700;
}
.j-module ol{ counter-reset: gp-ol; }
.j-module ol li::before{
  counter-increment: gp-ol;
  content: counter(gp-ol) ".";
  position: absolute;
  left: 0;
  top: 0.02em;
  color: #8B4F7A;
  font-weight: 600;
}

/* TOC */
.j-module ul.gp-toc{ list-style: none !important; padding-left: 0 !important; margin-left: 0 !important; }
.j-module ul.gp-toc li{ position: relative; padding-left: 1.4em !important; margin: 0.65em 0 !important; list-style: none !important; }
.j-module ul.gp-toc li::before{
  content: "↓" !important;
  position: absolute;
  left: 0;
  top: 0.05em;
  color: var(--gp-link);
  font-size: 0.95em;
  line-height: 1.2;
  transition: color .2s ease, transform .2s ease;
}
.j-module ul.gp-toc a{
  display: inline-block;
  color: var(--gp-link) !important;
  text-decoration: none !important;
  font-weight: 500;
  line-height: 1.45;
  transition: color .2s ease;
}
.j-module ul.gp-toc li:hover::before{ color: var(--gp-link-hover); transform: translateY(2px); }
.j-module ul.gp-toc a:hover,
.j-module ul.gp-toc a:focus{ color: var(--gp-link-hover) !important; }

/* =========================================
   9) Divider (gp-divider + Jimdo HR)
   ========================================= */
.gp-divider{
  background: transparent !important;
  height: auto !important;
  width: 100% !important;
  margin: var(--gp-divider-my) 0 !important;
  position: relative !important;
  display: block !important;
}
.gp-divider::after{
  content:"";
  display:block;
  width: var(--gp-divider-w);
  height: var(--gp-divider-h);
  margin: 0 auto;
  background: var(--gp-divider-color);
  border-radius: var(--gp-divider-r);
}

.j-hr > hr,
div.j-module.j-hr > hr,
div.j-module.n.j-hr > hr{
  border:0 !important;
  height:0 !important;
  background:transparent !important;
  margin:0 !important;
}
.j-hr,
div.j-module.j-hr,
div.j-module.n.j-hr{
  padding:0 !important;
  margin: var(--gp-divider-my) 0 !important;
  position:relative !important;
}
.j-hr::after,
div.j-module.j-hr::after,
div.j-module.n.j-hr::after{
  content:"";
  display:block;
  width: var(--gp-divider-w);
  height: var(--gp-divider-h);
  margin: 0 auto;
  background: var(--gp-divider-color);
  border-radius: var(--gp-divider-r);
}

/* =========================================
   10) Hinweisbox + Storybox
   ========================================= */
.gp-hint-box{
  background-color: #e8f1ec;
  padding: 18px 20px;
  border-radius: 14px;
  border: 0;
}
.gp-hint-box table{ border-collapse: collapse; }
.gp-hint-box td{ vertical-align: top; padding-bottom: 6px; }
.gp-hint-icon{
  padding-right: 10px;
  color: var(--gp-icon);
  font-size: 16px;
  line-height: 1.4;
  width: 1%;
  white-space: nowrap;
}

.gp-storybox{
  background: var(--gp-lila);
  border-radius: 12px;
  padding: 16px 18px;
  color: #fff;
}
.gp-storybox p{ margin: 0 0 10px 0; color: #fff; }

.gp-mehrsoft,
.gp-mehrsoft:visited{
  display: inline-block;
  margin: 6px 0 10px;
  padding: 6px 10px;
  border-radius: 10px;
  background: rgba(139, 79, 122, 0.16);
  border: 1px solid rgba(255,255,255,0.18);
  color: rgba(255,255,255,0.92) !important;
  font-weight: 600;
  text-decoration: none !important;
}
.gp-mehrsoft:hover,
.gp-mehrsoft:focus{ background: rgba(139, 79, 122, 0.22); color: #fff !important; }
.gp-mehrsoft--close{ margin-top: 10px; }

/* =========================================
   11) Galerie + Lightbox
   ========================================= */
.gp-gallery-swipe{
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 16px;
  margin: 10px 0;
}
@media (max-width: 768px){
  .gp-gallery-swipe{
    grid-auto-flow: column;
    grid-auto-columns: 85%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory;
    gap: 12px;
    padding-bottom: 10px;
  }
  .gp-gallery-swipe > a.gp-imglink{ scroll-snap-align: start; }
}
.gp-gallery-swipe a.gp-imglink{
  display: block;
  text-decoration: none !important;
  -webkit-tap-highlight-color: transparent;
  touch-action: manipulation;
}
.gp-gallery-swipe a.gp-imglink.gp-imgframe{
  position: relative;
  border-radius: 16px;
  overflow: hidden;
  border: 1px solid #d6e2db;
  background: #fff;
}
.gp-gallery-swipe a.gp-imgframe img{
  width: 100%;
  height: 300px;
  object-fit: cover;
  display: block;
  background: #f6f8f7;
}
@media (max-width: 768px){
  .gp-gallery-swipe a.gp-imgframe img{ height: 220px; }
}
@media (hover: hover) and (pointer: fine){
  .gp-gallery-swipe a.gp-imglink{ cursor: zoom-in !important; }
  .gp-gallery-swipe a.gp-imglink:hover img{ filter: brightness(0.98); }
}

/* =========================================
   UNIVERSAL MEDIA BLOCK
   ========================================= */

.gp-media-block img{
  width: 100%;
  height: 420px;                 /* Desktop Basis */
  object-fit: cover;
  object-position: center top;
  border-radius: 18px;
  display: block;
}

/* =========================================================
   DESKTOP LARGE (ab 1200px)
   – perfekt für 2-spaltige Layouts
   ========================================================= */
@media (min-width: 1200px){
  .gp-media-block img{
    height: 300px;
  }
}

/* =========================================================
   TABLET (600–900px)
   – etwas höher für mehr Präsenz
   ========================================================= */
@media (min-width: 600px) and (max-width: 900px){
  .gp-media-block img{
    height: 500px;
  }
}

/* =========================================================
   MOBILE (bis 820px)
   – vollbreit, ruhig
   ========================================================= */
@media (max-width: 820px){
  .gp-media-block img{
    height: 300px;
    border-radius: 14px;
  }
}
@media (max-width: 520px){
  .gp-media-block img{
    height: 220px;
    border-radius: 14px;
  }
}

.gp-lightbox{
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,.78);
  display: none;
  align-items: center;
  justify-content: center;
  padding: 24px;
  z-index: 99999;
}
.gp-lightbox.is-open{ display:flex; }
.gp-lightbox__inner{
  position: relative;
  max-width: min(1100px, 96vw);
  max-height: 90vh;
}
.gp-lightbox__img{
  max-width: 100%;
  max-height: 90vh;
  border-radius: 14px;
  display: block;
  box-shadow: 0 20px 60px rgba(0,0,0,.45);
}
.gp-lightbox__close{
  position: absolute;
  top: -14px;
  right: -14px;
  width: 40px;
  height: 40px;
  border-radius: 999px;
  border: 0;
  background: #fff;
  cursor: pointer;
  font-size: 22px;
  line-height: 40px;
}
.gp-lightbox__close:hover{ filter: brightness(.95); }
@media (max-width: 600px){
  .gp-lightbox{ padding: 16px; }
  .gp-lightbox__close{
    width: 44px;
    height: 44px;
    line-height: 44px;
    top: -12px;
    right: -12px;
  }
}

/* =========================================
   12) Therapie-Kacheln – klickbar
   ========================================= */
#lp-therapie-kacheln{
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 42px 36px;
  align-items: start;
  text-align: center;
  margin-top: 15px;
  margin-bottom: 20px;
}
@media (max-width: 820px){
  #lp-therapie-kacheln{
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 26px 22px;
  }
}
#lp-therapie-kacheln .lp-tile{
  margin: 0;
  padding: 0;
  position: relative;
}
#lp-therapie-kacheln .lp-box{
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  text-decoration: none;
}
#lp-therapie-kacheln .lp-tile > a.lp-box{
  position: absolute;
  inset: 0;
  z-index: 3;
  display: block;
  cursor: pointer;
}
#lp-therapie-kacheln .lp-icon,
#lp-therapie-kacheln .lp-title{
  position: relative;
  z-index: 2;
}
#lp-therapie-kacheln .lp-icon{
  height: 110px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12px;
}
#lp-therapie-kacheln .lp-icon img{
  display: block;
  width: auto;
  max-height: 100%;
  max-width: 120px;
}
#lp-therapie-kacheln .lp-title{
  margin: 0;
  font-size: 1.55rem;
  line-height: 1.5;
  font-weight: 400;
  text-align: center;
