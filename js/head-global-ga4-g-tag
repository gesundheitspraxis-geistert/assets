   ckies_powr_marketing oder ckies_marketing_third_party = allow/deny
   (Namen können leicht variieren → wir prüfen mehrere)
*/
(function(){

  function readCookie(name){
    var m = document.cookie.match(new RegExp('(?:^|; )' + name.replace(/([.$?*|{}()[\]\\/+^])/g,'\\$1') + '=([^;]*)'));
    return m ? decodeURIComponent(m[1]) : null;
  }

  function isAllow(val){
  if(!val) return false;
  val = String(val).toLowerCase().trim();
  return (val === 'allow' || val === 'true' || val === '1' || val === 'granted' || val === 'yes');
}


  function hasPerformance(){
    // bei dir im Screenshot: ckies_performance
    var v = readCookie('ckies_performance');
    if (isAllow(v)) return true;

    // fallback: manche Banner schreiben ckies_ga / ckies_analytics
