}
#lp-therapie-kacheln .lp-tile:has(> a.lp-box) .lp-title{ color: var(--gp-link) !important; }
#lp-therapie-kacheln .lp-tile > a.lp-box ~ .lp-title{ color: var(--gp-link) !important; }

@media (max-width: 820px){
  #lp-therapie-kacheln .lp-icon{ height: 78px; margin-bottom: 8px; }
  #lp-therapie-kacheln .lp-icon img{ max-width: 82px; }
  #lp-therapie-kacheln .lp-title{ font-size: 1.35rem; }
}
#lp-therapie-kacheln .lp-tile:hover .lp-icon img{
  opacity: 0.8;
  transition: opacity 0.15s ease-in-out;
}
#lp-therapie-kacheln .lp-tile:has(> a.lp-box):hover .lp-title,
#lp-therapie-kacheln .lp-tile > a.lp-box:hover ~ .lp-title{
  filter: brightness(0.85);
  transition: filter 0.15s ease-in-out;
}

/* =========================================
