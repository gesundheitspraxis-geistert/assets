/* =========================================
   FAQ – Akkordeon (Plus / Minus, clean)
   ========================================= */

body .gp-faq{
  width: 100% !important;
  margin-top: 26px !important; /* Abstand zur H2 */
}

/* Einzelner Kasten */
body .gp-faq details{
  border: 1px solid rgba(79,111,94,0.35) !important;
  border-radius: 14px !important;
  background: #ffffff !important;
  margin: 0 0 18px 0 !important;
  overflow: hidden !important;
}

/* Frage-Zeile */
body .gp-faq details > summary{
  list-style: none !important;
  cursor: pointer !important;
  padding: 16px 20px !important;
  font-size: 16px !important;
  line-height: 1.5 !important;
  font-weight: 600 !important;
  color: #4F6F5E !important;

  display: flex !important;
  justify-content: space-between !important;
  align-items: center !important;

  text-decoration: none !important;
  border: 0 !important;
  outline: none !important;
}

/* Hover – kein Unterstrich, aber klar klickbar */
body .gp-faq details > summary:hover{
  text-decoration: none !important;
  background: rgba(79,111,94,0.04) !important;
}

/* Default Marker entfernen */
body .gp-faq details > summary::-webkit-details-marker{ display: none !important; }
body .gp-faq details > summary::marker{ content: "" !important; }

/* Plus/Minus rechts */
body .gp-faq details > summary::after{
  content: "+" !important;
  font-size: 22px !important;
  font-weight: 400 !important;
  color: #4F6F5E !important;
  line-height: 1 !important;
  margin-left: 16px !important;
}
body .gp-faq details[open] > summary::after{ content: "–" !important; }

/* KEINE Trennlinie zwischen Frage und Antwort */
body .gp-faq details[open] > summary{ border-bottom: 0 !important; }

/* Antwort */
body .gp-faq details > .faq-answer{
  padding: 10px 20px 18px !important; /* <- Abstand rundum, kein "anklatschen" */
  margin: 0 !important;
  border: 0 !important;
  font-size: 16px !important;
  line-height: 1.5 !important;
  color: #333333 !important;
}

/* Absatzabstände in Antworten (ruhig, wie oben auf der Seite) */
body .gp-faq details > .faq-answer p{
  margin: 10px 0 0 !important;
}
body .gp-faq details > .faq-answer p:first-child{
  margin-top: 0 !important;
}

/* Links im FAQ: Jimdo-Standard überschreiben (das war dein "zu helles Grün") */
body .gp-faq .faq-answer a,
body .gp-faq .faq-answer a:visited{
  color: #4F6F5E !important;
  text-decoration: none !important;
  cursor: pointer !important;
  font-weight: 600 !important;
}
