/* =========================================
   FIX: Smooth Scroll + Scroll-Offset (Jimdo)
   ========================================= */

/* Smooth scroll global aktivieren */
html{
  scroll-behavior: smooth;
}

/* 
  Offset damit Anker nicht unter Header/Navi „kleben“.
  Wert ggf. anpassen: 110–140px ist meist passend.
*/


/* Für alle üblichen Ziele: Überschriften + Elemente mit ID */
h1[id], h2[id], h3[id], h4[id],
section[id], div[id], article[id], header[id]{
  scroll-margin-top: var(--gp-scroll-offset);
}

/* Optional: Wenn Jimdo beim Klicken oben minimal „zickt“,
   hilft das bei iOS/Chrome manchmal */
@media (prefers-reduced-motion: reduce){
  html{ scroll-behavior: auto; }
}
/* =========================================
   FAQ – Smooth ohne JS (nur wenn Browser es kann)
   Nutzt ::details-content (noch nicht überall verfügbar)
   ========================================= */

@supports selector(details::details-content){

  /* Animation für den Inhalt (Ein-/Ausblenden) */
  body .gp-faq details::details-content{
    overflow: hidden;
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity   .45s ease,
      transform .45s ease;
  }

  body .gp-faq details[open]::details-content{
    opacity: 1;
    transform: translateY(0);
  }

  /* Höhe (AUF + ZU) meditativ über max-height */
  body .gp-faq details > summary ~ *{
    max-height: 0;
    overflow: hidden;
    transition: max-height .9s cubic-bezier(.22,.61,.36,1);
  }

  body .gp-faq details[open] > summary ~ *{
    max-height: 2000px; /* ggf. erhöhen, falls Antworten länger */
  }
}

