    // aria-hidden passend setzen (für sauber)
    box.setAttribute('aria-hidden', isOpen ? 'true' : 'false');

    // Höhe animieren (weil du max-height nutzt)
    if(!isOpen){
      box.style.maxHeight = box.scrollHeight + 'px';
      box.style.opacity = '1';
    }else{
      box.style.maxHeight = '0px';
      box.style.opacity = '0';
    }

    // Linktext wechseln
    var openText  = link.getAttribute('data-text-open')  || '>> mehr lesen';
    var closeText = link.getAttribute('data-text-close') || '<< weniger anzeigen';
    link.textContent = isOpen ? openText : closeText;
  }

  document.addEventListener('click', toggleMehr, false);

  // Initial: alle gp-mehrboxen sicher auf "zu"
  document.querySelectorAll('.gp-mehrbox').forEach(function(box){
    box.classList.remove('is-open');
    box.setAttribute('aria-hidden','true');
    box.style.maxHeight = '0px';
    box.style.opacity = '0';
  });
})();
//]]>
</script>

